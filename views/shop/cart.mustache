{{>html_header_shop}}
{{>page_logo}}
<section class="page-container">
    {{>categories}}
    {{^empty}}
        {{#cart_contents}}
        <section class="cartContainer" hx-get="/functions/shop/cart_items.php" hx-trigger="load, cartUpdated from:body">
        </section>
        {{/cart_contents}}
        {{>shop/assoc_bundles}}
    {{/empty}}
    {{#empty}}
        <section class="shop-item">
            <p class="span2">Your cart is currently empty</p>
            {{>shop/back_to_shop}}
        </section>
    {{/empty}}
</section>
{{>html_footer}}