{{>html_header_shop}}
{{>page_logo}}
<section class="page-container">
    {{>categories}}
    {{^empty}}
        {{#cart_contents}}
        <section class="cartContainer" hx-get="/functions/shop/cart_items.php" hx-trigger="load, cartUpdated from:body">
        </section>
        {{/cart_contents}}
    {{/empty}}
    {{#empty}}
        <div class="shop-item">
            <p>Your cart is currently empty</p>
        </div>
        <a href="/shop">
            <div class="shop-item">
                Back to shop
            </div>
        </a>
    {{/empty}}
</section>
{{>html_footer}}