{{>html_header_shop}}
{{>categories}}
{{>cart_preview}}
    {{#item}}
    <section class='shop-item'>
        <div class="item-name"><h2>{{name}}</h2></div>
        <div class="item-img item-thumb" onclick="showFullsizeImage()">{{#image}}<img src='{{image_path}}' width='200'>{{/image}}</div>
        <div class="item-description"><p>{{{description}}}</p></div>
        {{#preorder}}
        <div class="preorder span2">This item is for preorder. It will be released on {{release_date_disp}}, online orders will be sent for delivery on that date</div>
        {{/preorder}}
        {{>item_interact}}
    </section>
    <div id="fullsize-image-container" class="fullsize-image-container">
        <i class="fa-solid fa-rectangle-xmark cancel" onclick="showFullsizeImage()"></i>

        {{#image}}<img class="responsive" src='{{image_path}}'>{{/image}}
    </div>
    {{/item}}
    {{>empty_cart}}
    <script src='/js/shop/updateItemPrice.js'></script>
    <script src='/js/shop/showFullsizeImage.js'></script>
{{>html_footer}}