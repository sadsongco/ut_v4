{{>html_header_shop}}
{{>page_logo}}
{{#session_timeout}}
    <h1 class="error">YOUR SESSION TIMED OUT. PLEASE TRY AGAIN.</h1>
{{/session_timeout}}
{{#technical_error}}
    <h1 class="error">There was a technical error. Your card has not been charged, and your cart has been emptied. Sorry about that, please try again.</h1>
{{/technical_error}}
{{>categories}}
{{>cart_preview}}
<section class="page-container" id="shopPage">
    <h2>SHOP</h2>
    <section class="article-container">
        <section class="article-body">
            <div class="article-head">
                <div class="article-title">Shipping To The Rest Of The World</div>
            </div>
            <p>
                We are very aware that at the moment shipping outside of the UK is very expensive. Unfortunately this is out of our hands. Tariff / customs charges have been an added for the EU and the USA on all goods. We only charge them at cost, but it still adds up to a lot. Sorry. Maybe one day we will be big enough to have fulfilment centres on other continents.
            </p>    
        </section>
    </section>
    <section class="article-container">
        <section class="article-body">
            <div class="article-head">
                <div class="article-title">Almost Here deluxe double LP out of stock</div>
            </div>
            <figure class="float-centered">
                <img style="max-width: 30%" src="/serve/images/images/UMCLP144-vinyl-mockup/jpeg/inline">
            </figure>
            <p>
                The deluxe double vinyl of Almost Here including the second disc of b-sides and rarities is currently out of stock. We are looking at getting some more, but currently the distributor is sold out as well. We'll keep you informed on the mailing list - add your email on our home page.
            </p>    
        </section>
    </section>
    <section class="cartContainer">
        <section class='show items'>
        <h2>Top Items</h2>
        {{#featured}}
            <section class='item'>
                <a href="/shop/item/{{item_id}}">
                <div class="link-container">
                    <p>{{name}}</p>
                    <p id="item{{item_id}}-price">&pound;{{price}}</p>
                    {{#image}}
                    <img src="{{image_path}}" alt="image" width="100">
                    {{/image}}
                </div>
                </a>
                {{>item_interact}}
            </section>
        {{/featured}}
        </section>
        <section class="show bundles">
            <h2>Bundles</h2>
            {{#bundles}}
                <section class="bundle">
                    <form hx-post='/functions/interface/shop/add_to_cart.php' hx-target='#bundleResult{{bundle_id}}' hx-swap='innerHTML'>
                    {{#items}}
                        <div class="bundle-item">
                            <p>{{name}}</p>
                            {{#image}}
                                <img src="{{image_path}}" alt="image" height="50px">
                            {{/image}}
                            {{>item_interact}}
                        </div>
                    {{/items}}
                    {{>bundle_interact}}
                    </form>
                </section>
            {{/bundles}}
        </section>
        <section class='show items'>
        <h2>Items</h2>
        {{#items}}
            <section class='item'>
                <a href="/shop/item/{{item_id}}">
                <div class="link-container">
                    <p>{{name}}</p>
                    <p id="item{{item_id}}-price">&pound;{{price}}</p>
                    {{#image}}
                    <img src="{{image_path}}" alt="image" width="100">
                    {{/image}}
                </div>
                </a>
                {{>item_interact}}
            </section>
        {{/items}}
        </section>
        <div id="cartMessage"></div>
    </section>
</section>
<script src="/js/shop/updateItemPrice.js"></script>
{{>html_footer}}